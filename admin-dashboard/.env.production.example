# Admin Dashboard Production Environment

# API Configuration
VITE_API_BASE_URL=https://api.adventure-platform.com/api/admin
VITE_GATEWAY_URL=https://api.adventure-platform.com

# Environment
VITE_NODE_ENV=production
VITE_APP_NAME=Adventure Platform Admin
VITE_APP_VERSION=1.0.0

# Features
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_LOGGING=false

# Authentication
VITE_TOKEN_STORAGE_KEY=adminToken
VITE_USER_STORAGE_KEY=adminData

# Pagination
VITE_DEFAULT_PAGE_SIZE=50
VITE_MAX_PAGE_SIZE=100

# Refresh Intervals (milliseconds)
VITE_ACTIVITY_LOG_REFRESH=30000
VITE_STATS_REFRESH=60000
