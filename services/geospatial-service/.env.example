# Server Configuration
NODE_ENV=development
GEOSPATIAL_SERVICE_PORT=3007
SERVICE_NAME=geospatial-service

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=adventure_user
POSTGRES_PASSWORD=adventure_pass
POSTGRES_DB=adventure_platform
POSTGRES_SSL=false

# MongoDB Configuration (for geospatial data)
MONGODB_URI=mongodb://adventure_user:adventure_pass@mongodb:27017/adventure_platform
MONGODB_DATABASE=adventure_platform

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=5

# JWT Configuration
JWT_ACCESS_SECRET=dev-access-secret-change-in-production

# Service URLs
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3003
QUEST_SERVICE_URL=http://quest-service:3004

# Geospatial Configuration
DEFAULT_GEOFENCE_RADIUS=50
MAX_TRACKING_DISTANCE_KM=500
LOCATION_UPDATE_INTERVAL_MS=5000
MAX_LOCATION_HISTORY=1000
ENABLE_REAL_TIME_TRACKING=true

# Routing Configuration
DEFAULT_ROUTING_PROFILE=walking
MAX_WAYPOINTS=25

# Logging
LOG_LEVEL=info
