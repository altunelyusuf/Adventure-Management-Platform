# Server Configuration
NODE_ENV=development
GAMIFICATION_SERVICE_PORT=3005
SERVICE_NAME=gamification-service

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=adventure_user
POSTGRES_PASSWORD=adventure_pass
POSTGRES_DB=adventure_platform
POSTGRES_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3

# Authentication
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
AUTH_SERVICE_URL=http://localhost:3001

# External Services
QUEST_SERVICE_URL=http://localhost:3004
USER_SERVICE_URL=http://localhost:3003

# XP System Configuration
XP_CHECKPOINT_EASY=50
XP_CHECKPOINT_MEDIUM=100
XP_CHECKPOINT_HARD=200
XP_CHECKPOINT_EXPERT=400
XP_QUEST_EASY=500
XP_QUEST_MEDIUM=1000
XP_QUEST_HARD=2000
XP_QUEST_EXPERT=4000
XP_DAILY_LOGIN=50
XP_FIRST_QUEST_DAILY=200
XP_SOCIAL_SHARE=25
XP_PHOTO_UPLOAD=10
XP_QUEST_REVIEW=50
XP_FRIEND_REFERRAL=1000

# XP Bonuses (percentages)
XP_PERFECT_COMPLETION_BONUS=25
XP_SPEED_COMPLETION_BONUS=15
XP_FIRST_COMPLETION_BONUS=50
XP_WEEKEND_BONUS=10

# Level Configuration
LEVEL_BASE_XP=1000
LEVEL_GROWTH_RATE=1.15
MAX_LEVEL=100

# Achievement Configuration
ACHIEVEMENT_XP_REWARD=100

# Leaderboard Configuration
LEADERBOARD_PAGE_SIZE=50
LEADERBOARD_CACHE_TTL=300
LEADERBOARD_TOP_N=100

# Challenge Configuration
CHALLENGE_RESET_HOUR=0
CHALLENGE_XP_MULTIPLIER=1.5

# Streak Configuration
STREAK_GRACE_PERIOD_HOURS=6
STREAK_MAX_FREEZE_COUNT=3
STREAK_XP_PER_DAY=50

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
