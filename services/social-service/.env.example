# Server Configuration
NODE_ENV=development
SOCIAL_SERVICE_PORT=3006
SERVICE_NAME=social-service

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=adventure_user
POSTGRES_PASSWORD=adventure_pass
POSTGRES_DB=adventure_platform
POSTGRES_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=4

# Authentication
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
AUTH_SERVICE_URL=http://localhost:3001

# External Services
USER_SERVICE_URL=http://localhost:3003
QUEST_SERVICE_URL=http://localhost:3004
GAMIFICATION_SERVICE_URL=http://localhost:3005

# Friend System Configuration
MAX_FRIENDS=500
FRIEND_REQUEST_EXPIRY_DAYS=30
MAX_PENDING_REQUESTS=50

# Activity Feed Configuration
FEED_PAGE_SIZE=20
MAX_FEED_ITEMS=1000
ACTIVITY_RETENTION_DAYS=90

# Interaction Configuration
MAX_COMMENT_LENGTH=500
ENABLE_NESTED_COMMENTS=true
MAX_COMMENT_DEPTH=3

# Notification Configuration
ENABLE_PUSH_NOTIFICATIONS=true
NOTIFICATION_BATCH_SIZE=100

# Follow System Configuration
ENABLE_FOLLOW_SYSTEM=true
MAX_FOLLOWING=1000

# Privacy Configuration
DEFAULT_PROFILE_VISIBILITY=PUBLIC
ALLOW_ANONYMOUS_VIEWING=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
