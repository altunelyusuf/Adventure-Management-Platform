# Server Configuration
NODE_ENV=development
PAYMENT_SERVICE_PORT=3009
SERVICE_NAME=payment-service

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=adventure_user
POSTGRES_PASSWORD=adventure_pass
POSTGRES_DB=adventure_platform
POSTGRES_SSL=false

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=7

# JWT Configuration
JWT_ACCESS_SECRET=dev-access-secret-change-in-production

# Service URLs
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3003
QUEST_SERVICE_URL=http://quest-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3008

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_API_VERSION=2023-10-16

# Payment Configuration
PLATFORM_FEE_PERCENTAGE=30
CREATOR_SHARE_PERCENTAGE=70
CURRENCY=USD
MIN_SUBSCRIPTION_PRICE=4.99
MAX_SUBSCRIPTION_PRICE=99.99

# Subscription Tiers
TIER_BASIC_PRICE=4.99
TIER_STANDARD_PRICE=9.99
TIER_PREMIUM_PRICE=19.99

# Payout Configuration
MIN_PAYOUT_AMOUNT=50.00
PAYOUT_SCHEDULE=monthly
AUTO_PAYOUT_ENABLED=true

# Logging
LOG_LEVEL=info
