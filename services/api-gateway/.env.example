# Server Configuration
NODE_ENV=development
GATEWAY_PORT=3000
SERVICE_NAME=api-gateway

# Redis Configuration (for rate limiting)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=8

# Service URLs
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3003
QUEST_SERVICE_URL=http://quest-service:3004
GAMIFICATION_SERVICE_URL=http://gamification-service:3005
SOCIAL_SERVICE_URL=http://social-service:3006
GEOSPATIAL_SERVICE_URL=http://geospatial-service:3007
NOTIFICATION_SERVICE_URL=http://notification-service:3008
PAYMENT_SERVICE_URL=http://payment-service:3009

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Request Configuration
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT_MS=30000

# Security
ENABLE_HELMET=true
TRUST_PROXY=false

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined
