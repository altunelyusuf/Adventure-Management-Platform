# ==============================================================================
# ADVENTURE MANAGEMENT PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env files to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
# Options: development, staging, production

# ------------------------------------------------------------------------------
# API Gateway
# ------------------------------------------------------------------------------
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3001,http://localhost:3012
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Microservices Ports
# ------------------------------------------------------------------------------
AUTH_SERVICE_PORT=3001
QUEST_SERVICE_PORT=3002
PROFILE_SERVICE_PORT=3003
GAMIFICATION_SERVICE_PORT=3004
SOCIAL_SERVICE_PORT=3005
GEOSPATIAL_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
PAYMENT_SERVICE_PORT=3008
MEDIA_SERVICE_PORT=3009
ANALYTICS_SERVICE_PORT=3010
ADMIN_SERVICE_PORT=3011

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Individual Database Names
AUTH_DB=adventure_auth
QUEST_DB=adventure_quests
PROFILE_DB=adventure_profiles
GAMIFICATION_DB=adventure_gamification
SOCIAL_DB=adventure_social
ADMIN_DB=adventure_admin

# Connection URLs (Auto-generated in production)
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adventure_auth
QUEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adventure_quests
PROFILE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adventure_profiles
GAMIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adventure_gamification
SOCIAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adventure_social
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adventure_admin

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# ------------------------------------------------------------------------------
# MongoDB Configuration (Geospatial Service)
# ------------------------------------------------------------------------------
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=admin
MONGODB_PASSWORD=admin
MONGODB_DATABASE=adventure_geospatial
MONGODB_URL=mongodb://admin:admin@localhost:27017/adventure_geospatial?authSource=admin

# ------------------------------------------------------------------------------
# Email Configuration (Notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=Adventure Platform <noreply@adventure-platform.com>

# ------------------------------------------------------------------------------
# AWS Configuration (S3 for Media)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=adventure-platform-media
AWS_S3_PUBLIC_URL=https://adventure-platform-media.s3.amazonaws.com

# ------------------------------------------------------------------------------
# Payment Gateway (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ------------------------------------------------------------------------------
# Media Service Configuration
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
# Max file size in bytes (10MB)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
SESSION_SECRET=your-session-secret-minimum-32-characters
SESSION_TTL=86400
# 24 hours in seconds

# ------------------------------------------------------------------------------
# Frontend URLs
# ------------------------------------------------------------------------------
WEB_APP_URL=http://localhost:3001
ADMIN_DASHBOARD_URL=http://localhost:3012
MOBILE_DEEP_LINK_SCHEME=adventureplatform://

# ------------------------------------------------------------------------------
# Monitoring & Logging
# ------------------------------------------------------------------------------
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
SENTRY_DSN=
# Optional: Sentry error tracking DSN

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
TOKEN_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
ENABLE_SOCIAL_LOGIN=false
ENABLE_PAYMENT_PROCESSING=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# ------------------------------------------------------------------------------
# Development Tools
# ------------------------------------------------------------------------------
ENABLE_SWAGGER=true
ENABLE_DEBUG_LOGGING=true
ENABLE_CORS=true

# ------------------------------------------------------------------------------
# Testing
# ------------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adventure_test
TEST_REDIS_URL=redis://localhost:6379/1
