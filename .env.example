# Adventure Management Platform - Environment Variables
# Copy this file to .env and update with your actual values

# Application
NODE_ENV=development
APP_NAME=Adventure Management Platform
APP_VERSION=0.1.0-alpha
APP_PORT=3000
APP_URL=http://localhost:3000

# Database - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adventure_platform
POSTGRES_USER=adventure_user
POSTGRES_PASSWORD=adventure_pass
DATABASE_URL=postgresql://adventure_user:adventure_pass@localhost:5432/adventure_platform

# Database - MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=adventure_user
MONGODB_PASSWORD=adventure_pass
MONGODB_DATABASE=adventure_platform
MONGODB_URL=mongodb://adventure_user:adventure_pass@localhost:27017/adventure_platform

# Cache - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Search - Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Message Queue - RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=adventure_user
RABBITMQ_PASSWORD=adventure_pass
RABBITMQ_URL=amqp://adventure_user:adventure_pass@localhost:5672

# Object Storage - Minio (Development) / S3 (Production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=adventure_user
S3_SECRET_KEY=adventure_pass
S3_BUCKET=adventure-platform
S3_REGION=us-east-1

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=30d

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey.p8

# Payment Processing - Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email Service
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@adventure-platform.com
SMTP_FROM_NAME=Adventure Platform

# SendGrid (Production)
SENDGRID_API_KEY=your-sendgrid-api-key

# AI Services - Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# Maps & Geolocation
MAPBOX_ACCESS_TOKEN=your-mapbox-token
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# AR Services
APPLE_AR_KIT_KEY=your-arkit-key
GOOGLE_AR_CORE_KEY=your-arcore-key

# Monitoring & Observability
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
DATADOG_API_KEY=your-datadog-api-key

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your-mixpanel-token

# Social Media Integration
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
DISCORD_BOT_TOKEN=your-discord-bot-token

# Streaming Services
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
YOUTUBE_API_KEY=your-youtube-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Session
SESSION_SECRET=your-session-secret-change-this-in-production
SESSION_MAX_AGE=86400000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Feature Flags
FEATURE_AI_QUEST_GENERATION=false
FEATURE_AR_EXPERIENCES=false
FEATURE_LIVE_STREAMING=false
FEATURE_SOCIAL_FEATURES=true
FEATURE_GAMIFICATION=true

# Admin
ADMIN_EMAIL=admin@adventure-platform.com
ADMIN_PASSWORD=change-this-in-production
